# Streamlit secrets 模板
# ──────────────────────────────────────────────────────────
# 本地用法：复制本文件为 .streamlit/secrets.toml 并填入真实 key
#           （secrets.toml 已被 .gitignore，不会上传）
# 云端用法：在 Streamlit Cloud → App → Settings → Secrets 里
#           粘贴下面两行（填真实 key）。
# ──────────────────────────────────────────────────────────

ANTHROPIC_API_KEY = "sk-ant-xxxxxxxxxxxxxxxx"
VOYAGE_API_KEY    = "pa-xxxxxxxxxxxxxxxx"
